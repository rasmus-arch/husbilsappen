# Kopiera till .env för lokal utveckling, eller sätt samma variabler
# som miljövariabler hos ditt webbhotell för drift i produktion.

# MySQL/MariaDB-anslutning
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=husbilsappen
DB_PASSWORD=
DB_NAME=husbilsappen

# Lösenord som skyddar hela appen (ingen inloggning per användare)
APP_PASSWORD=

# Lång slumpad hemlighet som signerar inloggningssessioner.
# Generera t.ex. med: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=

# Valfri: hemlig kod för den publika, lösenordsfria delningslänken till
# loggboken (https://din-domän/#/dela/<KOD>). Lämna tom för att stänga av
# delningsfunktionen helt. Generera t.ex. med:
# node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
LOGBOOK_SHARE_TOKEN=

# Porten servern lyssnar på (webbhotell sätter ofta denna åt dig)
PORT=3000
