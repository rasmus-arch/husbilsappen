# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

node_modules
dist-ssr
*.local

# dist/ (built frontend) IS committed on purpose: the production host has
# too little memory to run `npm run build` itself, so the build is done
# here and the output is deployed via `git pull`. Rebuild and commit dist/
# whenever src/ changes.

# Environment / secrets - never commit real credentials
.env
.env.*
!.env.example

# Uploaded logbook images live on the server's disk, not in git
server/uploads/*
!server/uploads/.gitkeep

# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
